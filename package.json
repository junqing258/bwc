{
  "name": "bwc-dwg-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "tsx apps/server/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:geometry": ".venv/bin/python -m unittest discover -s apps/workers/geometry -p 'test_*.py'",
    "probe": "tsx scripts/probe.ts",
    "mcp": "tsx apps/server/mcp.ts",
    "host:probe": "tsx scripts/host-probe.ts",
    "format": "prettier --write apps/server apps/web scripts tests tsconfig.json package.json",
    "check": "npm test && npm run test:geometry && npm run build",
    "host:smoke": "tsx scripts/bridge-smoke.ts",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.63.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.183.2",
    "zod": "3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  }
}
